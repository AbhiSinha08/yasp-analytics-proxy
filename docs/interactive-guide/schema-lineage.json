  "cards": [
    {
      "dot": "cyan",
      "title": "Example output lineage",
      "items": [
        "SELECT o.total AS revenue FROM reporting.orders_v2 AS o",
        "Output ordinal 0, revenue, traces to the source column reporting.orders_v2.total.",
        "Known source coordinates include database, schema, relation and column."
      ]
    },
    {
      "dot": "cyan",
      "title": "Schema and context differ",
      "items": [
        "The catalog contains source facts: relations, columns, native types and reported keys.",
        "Application datasets contain mappings such as users and roles. Derived query context contains per-query app values."
      ]
    },
    {
      "dot": "amber",
      "title": "Freshness and limits",
      "items": [
        "Failed refresh retains the previous catalog generation without resetting its age. Expired metadata is rejected.",
        "Unknown lineage stays explicit; schema facts and model outputs do not establish access rights."
