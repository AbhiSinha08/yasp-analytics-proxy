  "cards": [
    {
      "dot": "cyan",
      "title": "Scope",
      "items": [
        "Ordinary read-only simple query, outside an explicit transaction, shown on a cache miss.",
        "Context, modification and result processing are optional. Configured routing invokes the selector."
      ]
    },
    {
      "dot": "amber",
      "title": "Before this path",
      "items": [
        "Recognized metadata uses the catalog. Frontend setup and transaction controls use their own handling.",
        "These paths bypass ordinary query context, modification, selection and result callbacks."
      ]
    },
    {
      "dot": "emerald",
      "title": "Streaming",
      "items": [
        "The processing exchange repeats per bounded batch; it does not collect the entire result.",
        "Optional classification runs on a bounded raw prefix before result callbacks."
      ]
    }
  ]
