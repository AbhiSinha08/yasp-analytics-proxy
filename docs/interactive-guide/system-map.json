  "cards": [
    {
      "dot": "cyan",
      "title": "Reusable library + host",
      "items": [
        "The consuming application registers callbacks and supplies configuration before listening.",
        "The engine owns invocation, validation, adapters and resource limits."
      ]
    },
    {
      "dot": "emerald",
      "title": "Optional paths",
      "items": [
        "Raw result caching is opt-in. Hits still select a current route and run current result processing.",
        "Catalog metadata and frontend controls bypass ordinary query callbacks."
      ]
    },
    {
      "dot": "amber",
      "title": "Expansion boundary",
      "items": [
        "Client protocol, source adapter and SQL translation are separate capabilities.",
        "Automatic translation, lifecycle callbacks and mandatory engine masking remain planned."
      ]
    }
  ]
