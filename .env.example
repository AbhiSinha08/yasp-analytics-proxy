# Frontend login and database label used by PostgreSQL clients of the proxy.
YASP_GATEWAY_USERNAME=yasp
YASP_GATEWAY_PASSWORD=change_me
YASP_GATEWAY_DATABASE=yasp
LOG_LEVEL=WARN
# Target login password key referenced by config/example.yml.
YASP_PRIMARY_RESTRICTED_PASSWORD=change_me
# Target login password key referenced by tests/config.yml.
YASP_TEST_TARGET_PASSWORD=change_me
