# Frontend login and database label used by PostgreSQL clients of the proxy.
YASP_GATEWAY_USERNAME=yasp
YASP_GATEWAY_PASSWORD=change_me
YASP_GATEWAY_DATABASE=yasp
LOG_LEVEL=WARN
# Target login credentials; config/local.yml uses YASP_PRIMARY_RESTRICTED_PASSWORD.
YASP_PRIMARY_RESTRICTED_PASSWORD=change_me
YASP_PRIMARY_ANALYST_PASSWORD=change_me
YASP_SECONDARY_RESTRICTED_PASSWORD=change_me
YASP_SECONDARY_ANALYST_PASSWORD=change_me
# Optional full-project integrations.
YASP_METABASE_SCRAM_VERIFIER=change_me
YASP_REDIS_URL=redis://127.0.0.1:6379
# Target login password key referenced by tests/config.yml.
YASP_TEST_TARGET_PASSWORD=change_me
# Pre-provisioned secondary login used by config/local.yml and tests/config.yml.
YASP_TEST_SECOND_PASSWORD=change_me
