# Local development only. configure.py fills blank keys, preserving legacy keys
# when the existing yasp-superset/yasp-redash-server containers are available.
SUPERSET_SECRET_KEY=
REDASH_SECRET_KEY=
REDASH_COOKIE_SECRET=

METABASE_DB_PASSWORD=password
SUPERSET_METADATA_DATABASE_URI=postgresql+psycopg2://local:password@host.docker.internal:5432/superset
REDASH_DATABASE_URL=postgresql://local:password@host.docker.internal:5432/redash
REDASH_REDIS_URL=redis://host.docker.internal:6379/0

# Public gateway CA, relative to dev/bi/; never mount the private CA key.
YASP_CA_FILE=../../config/local-tls/ca.crt
