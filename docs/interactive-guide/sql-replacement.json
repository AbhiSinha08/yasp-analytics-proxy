  "cards": [
    {
      "dot": "cyan",
      "title": "Existing Rust example",
      "items": [
        "SELECT o.id, o.total FROM logical.orders AS o",
        "becomes SELECT o.id, o.total FROM reporting.orders_v2 AS o.",
        "The table-rename callback preserves explicit aliases and rejects matching tables without an alias."
      ]
    },
    {
      "dot": "cyan",
      "title": "Context stays stable",
      "items": [
        "Context is derived once from original SQL. Rewriting does not derive it again or change its resolved dialect.",
        "The modifier receives no final query ID, lineage, selected route or result classifications."
      ]
    },
    {
      "dot": "amber",
      "title": "Policy belongs to the application",
      "items": [
        "The engine validates execution syntax and configured bounds; the app owns transformation meaning.",
        "Automatic cross-dialect translation is planned. A configured replacement is already available."
      ]
    }
