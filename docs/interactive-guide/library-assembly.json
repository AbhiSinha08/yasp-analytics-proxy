    {
      "dot": "cyan",
      "title": "Application code stays outside core",
      "items": [
        "Bind application state to narrow callback contracts; register names and params at startup.",
        "Rust extensions compile with the consuming application. Python files are supplied before startup."
      ]
    },
    {
      "dot": "amber",
      "title": "Readiness and failure",
      "items": [
        "Configured dataset load failures and initial catalog load failures prevent serving.",
        "Dataset refresh failures retain the last good data. Catalog refresh failures retain the last generation without extending its age."
      ]
    },
    {
      "dot": "emerald",
      "title": "Logical prerequisites",
      "items": [
        "Datasets load before adapter construction. The catalog is loaded before the listener starts.",
        "Optional cache, lineage, classification and result hooks are attached only when configured."
